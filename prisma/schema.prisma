generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPERADMIN
  ADMIN
}

model Category {
  id           String  @id @default(cuid())
  name         String  @unique
  description  String?
  catalogueUrl String?
  active       Boolean @default(true)
  
  userId       String
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String  @id @default(cuid())
  categoryId  String
  modelNumber String
  productName String?
  pdfUrl      String?
  active      Boolean @default(true)

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  enquiries Enquiry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, modelNumber])
  @@index([categoryId])
}

model Customer {
  id     String @id @default(cuid())
  name   String
  mobile String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  enquiries Enquiry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Enquiry {
  id         String  @id @default(cuid())
  customerId String
  productId  String
  notes      String?
  status     String  @default("NEW")
  source     String  @default("ADMIN")

  nextReminderDate DateTime?
  nextReminderNote String?
  isReminderActive Boolean   @default(false)

  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  interactions Interaction[]

  createdAt DateTime @default(now())

  @@index([customerId])
  @@index([productId])
  @@index([createdAt])
  @@index([isReminderActive, nextReminderDate])
}

model Interaction {
  id          String   @id @default(cuid())
  enquiryId   String
  type        String   
  outcome     String?  
  notes       String?  
  createdAt   DateTime @default(now())

  enquiry     Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  @@index([enquiryId])
  @@index([createdAt])
}

model User {
  id        String   @id @default(cuid())
  name      String
  mobile    String   @unique
  pinHash   String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories        Category[]
  products          Product[]
  customers         Customer[]
  enquiries         Enquiry[]
  messageTemplates  MessageTemplate[]
  monthlyTargets    MonthlyTarget[]
}

model MessageTemplate {
  id        String   @id @default(cuid())
  name      String
  content   String
  isDefault Boolean  @default(false)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MonthlyTarget {
  id             String   @id @default(cuid())
  userId         String
  month          String   // Format: "YYYY-MM" (e.g., "2026-09")
  targetAmount   Float    @default(0)
  achievedAmount Float    @default(0)
  
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries        TargetEntry[]
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, month])
}

model TargetEntry {
  id              String   @id @default(cuid())
  monthlyTargetId String
  amount          Float
  date            DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  monthlyTarget   MonthlyTarget @relation(fields: [monthlyTargetId], references: [id], onDelete: Cascade)
}
